{
  "version": 3,
  "hooks": {
    "agy-hud-update": {
      "PostToolUse": [
        {
          "matcher": ".*",
          "hooks": [
            {
              "type": "command",
              "command": "node ./test_install_env/src/index.mjs --update"
            }
          ]
        }
      ],
      "PostInvocation": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "node ./test_install_env/src/index.mjs --update"
            }
          ]
        }
      ]
    }
  }
}
